<Project Sdk="Microsoft.NET.Sdk">
  <!-- Replays simulated laptops through the app's real battery code. Run before every release:
       dotnet run -c Release   (from this folder). Exit code 0 only if every check passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8632;CA2014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Battery\BatteryDriver.cs" Link="App\BatteryDriver.cs" />
    <Compile Include="..\..\Battery\BatteryReader.cs" Link="App\BatteryReader.cs" />
    <Compile Include="..\..\Battery\DirectionJudge.cs" Link="App\DirectionJudge.cs" />
    <Compile Include="..\..\Battery\DrawModel.cs" Link="App\DrawModel.cs" />
    <Compile Include="..\..\Battery\RateEstimator.cs" Link="App\RateEstimator.cs" />
    <Compile Include="..\..\Display.cs" Link="App\Display.cs" />
  </ItemGroup>
</Project>
